[Unit]
Description=Build the TAM daily digest before the 08:00 review

[Timer]
# Local time (Asia/Jerusalem). Five minutes ahead of the review so the
# digest is already on disk when the morning session starts.
OnCalendar=*-*-* 07:55:00
# Fire on next wake if the machine was asleep or off at 07:55 -- a missed
# morning must not leave a hole in the record.
Persistent=true
Unit=tam-digest.service

[Install]
WantedBy=timers.target
