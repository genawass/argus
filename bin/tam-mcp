#!/bin/sh
# TAM MCP stdio server. Protocol frames on stdout, logs on stderr.
ROOT=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)

# MCP clients spawn this with a bare environment -- no TAM_HOME, no
# TAM_API_URL -- so without this the server silently falls back to the default
# data root and serves an empty local database instead of the real one.
#
# .tam-env is host-local and sets TAM_HOME only. To run this server against a
# remote TAM instead, point TAM_ENV at a file that exports TAM_API_URL and
# TAM_API_TOKEN: tam/mcp.py switches to the HTTP client when TAM_API_URL is
# set, so the same binary serves both without a second code path.
#
# Redirect to stderr while sourcing: anything printed on stdout would be
# parsed as a protocol frame.
if [ -r "${TAM_ENV:-$ROOT/.tam-env}" ]; then
    . "${TAM_ENV:-$ROOT/.tam-env}" >&2
fi

exec env PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}" python3 -m tam.mcp "$@"
